{
  "name": "file-relay",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force && tsc --project tsconfig.worker.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply drop-db --local",
    "deploy": "vite build &&wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.0",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "^4.20251101.0",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vue/test-utils": "^2.4.6",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "0.44.7",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.0",
    "wrangler": "^4.45.0"
  }
}
