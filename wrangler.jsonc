{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drop",
  "main": "server/index.ts",
  "compatibility_date": "2026-08-12",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drop-db",
      "database_id": "24210d6b-1195-4964-b861-954730e473f6",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "drop-files"
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "vars": {
    "APP_ORIGIN": "https://drop.28207.cc",
    "OWNER_GITHUB_ID": "33075299",
    "GITHUB_CLIENT_ID": "Ov23lilL3UVb1yQJOXpc",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEPpZb8bVP6zjyFR",
    "UPLOAD_CHUNK_SIZE": "33554432",
    "MAX_FILE_SIZE": "2147483648",
    "SESSION_TTL_SECONDS": "2592000",
    "DEFAULT_RETENTION_DAYS": "30"
  }
}
