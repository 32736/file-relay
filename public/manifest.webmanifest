{
  "name": "Drop",
  "short_name": "Drop",
  "description": "Private file transfer",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#eeece6",
  "theme_color": "#e85b3f",
  "icons": [
    {
      "src": "/logo.svg?v=2",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/logo.svg?v=2",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "video/*",
            "audio/*",
            "text/*",
            "application/*"
          ]
        }
      ]
    }
  }
}
